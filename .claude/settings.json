{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/normalize-edited-markdown.sh",
            "timeout": 120,
            "statusMessage": "Formatting markdown"
          }
        ]
      }
    ]
  }
}
